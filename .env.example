# Akun admin awal (dibuat hanya saat koleksi users di Firestore masih kosong)
ADMIN_EMAIL=admin@klien.co.id
ADMIN_PASSWORD=isi-password-kuat

# Firebase: Project settings > Service accounts > Generate new private key.
# Pilih SALAH SATU cara (atau FIREBASE_SERVICE_ACCOUNT_FILE=./nama-file.json untuk lokal):
# 1) Seluruh JSON service account (satu baris) atau base64-nya:
FIREBASE_SERVICE_ACCOUNT=
# 2) Atau tiga variabel terpisah:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Bucket Firebase Storage (default: <project-id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# Zona waktu untuk statistik harian (default Asia/Jakarta)
# APP_TIMEZONE=Asia/Jakarta

# Port server produksi (bila tidak di Vercel)
PORT=3000
